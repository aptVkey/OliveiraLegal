# Supabase (projeto alojado na UE). Copie para .env.local e preencha.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor (nunca NEXT_PUBLIC_). Necessária para convidar e gerir membros da equipa.
# Supabase → Project Settings → API Keys → Secret key. Cole-a aqui diretamente, nunca no chat.
SUPABASE_SECRET_KEY=

# ── Agendamento de consultas (site → Stripe) ──
# URL público do site, usado no regresso do pagamento (ex.: https://oliveiralegal.com)
SITE_URL=
# Stripe → Developers → API keys (Secret key: sk_test_… em testes, sk_live_… em produção)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://SEU-DOMINIO/api/stripe/webhook → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=

# E-mails de confirmação com o convite .ics (https://resend.com → API Keys; domínio verificado)
RESEND_API_KEY=
BOOKING_EMAIL_FROM="Oliveira Legal <no-reply@oliveiralegal.com>"
# Destino dos pedidos do formulário de contacto (opcional; por defeito geral@oliveiralegal.com)
CONTACT_EMAIL_TO="geral@oliveiralegal.com"
