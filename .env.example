# Supabase (projeto alojado na UE). Copie para .env.local e preencha.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor (nunca NEXT_PUBLIC_). Necessária para convidar e gerir membros da equipa.
# Supabase → Project Settings → API Keys → Secret key. Cole-a aqui diretamente, nunca no chat.
SUPABASE_SECRET_KEY=
